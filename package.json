{
  "name": "swarmstudio-2d-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SwarmStudio 二维点阵编辑器 - Vue3 + TypeScript + PixiJS + SQLite(WASM)/OPFS",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:image": "node scripts/smoke-image.mjs",
    "gen": "node scripts/gen-points.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "pixi.js": "^8.6.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "packageManager": "pnpm@10.18.2"
}
